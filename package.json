{
  "name": "railsentinel",
  "private": true,
  "version": "0.1.0-alpha",
  "description": "RailSentinel \u2014 middleware IIoT/ATS de proxima geracao para o CCO do VLT da Baixada Santista (Fase 1: simulacao e middleware, TRL 3-5)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/contracts",
    "packages/pki",
    "packages/historian",
    "packages/plant",
    "services/ingest-gateway",
    "services/ats-core",
    "services/operator-api",
    "services/ntcip-emulator",
    "services/historian"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "brokers": "node --experimental-strip-types tools/dev-brokers.ts",
    "keys": "node --experimental-strip-types tools/provision-keys.ts",
    "gateway": "node services/ingest-gateway/dist/main.js",
    "ats": "node services/ats-core/dist/main.js",
    "operator": "node services/operator-api/dist/main.js",
    "sim": "python3 edge/jetson_sim/edge_node.py",
    "dev": "node --experimental-strip-types tools/dev-all.ts",
    "test": "npm run build && node --test --experimental-strip-types tests/*.test.ts",
    "fleet": "node --experimental-strip-types tools/fleet-sim.ts",
    "ntcip": "node services/ntcip-emulator/dist/main.js",
    "stability": "npm run build && node --experimental-strip-types tools/stability-bench.ts",
    "stability:report": "npm run build && node --experimental-strip-types tools/stability-bench.ts --write",
    "setup-pki": "node --experimental-strip-types tools/setup-pki.ts",
    "historian": "node services/historian/dist/main.js",
    "db:migrate": "node --experimental-strip-types tools/db-migrate.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.14",
    "aedes": "^0.51.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "net-snmp": "^3.29.1",
    "node-forge": "^1.4.0",
    "pg": "^8.23.0"
  }
}